# Django Core Settings
SECRET_KEY=django-insecure-change-this-in-production-key-9a8b7c6d5e4f3a2b1c
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.impactinstituteglobal.org,.thenovatrix.com,backend

# PostgreSQL Database Configuration
DB_NAME=tiipe_novatrix_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Multi-Tenant Domains & Public Domain
PUBLIC_DOMAIN=localhost
