{
  "info": {
    "name": "TIIPE & Novatrix Multi-Tenant REST API",
    "description": "Comprehensive Postman API collection for TIIPE (Parent) and Novatrix (Subsidiary) multi-tenant backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "tenant_header",
      "value": "tiipe",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant", "value": "{{tenant_header}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"learner@example.com\",\n  \"password\": \"SecurePass2026!\",\n  \"first_name\": \"Marcus\",\n  \"last_name\": \"Learner\",\n  \"phone\": \"+1 914-555-0144\",\n  \"role\": \"learner\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/register/", "host": ["{{base_url}}"], "path": ["auth", "register", ""] }
          }
        },
        {
          "name": "Login (JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.tokens && jsonData.tokens.access) {",
                  "    pm.collectionVariables.set('access_token', jsonData.tokens.access);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant", "value": "{{tenant_header}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@impactinstituteglobal.org\",\n  \"password\": \"AdminPassword2026!\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login/", "host": ["{{base_url}}"], "path": ["auth", "login", ""] }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "X-Tenant", "value": "{{tenant_header}}" }
            ],
            "url": { "raw": "{{base_url}}/auth/me/", "host": ["{{base_url}}"], "path": ["auth", "me", ""] }
          }
        }
      ]
    },
    {
      "name": "2. CMS (Dynamic Content)",
      "item": [
        {
          "name": "Get Hero Sections",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant", "value": "{{tenant_header}}" }],
            "url": { "raw": "{{base_url}}/cms/heroes/", "host": ["{{base_url}}"], "path": ["cms", "heroes", ""] }
          }
