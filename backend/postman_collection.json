          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant", "value": "tiipe" }],
            "url": { "raw": "{{base_url}}/cms/media-broadcasts/", "host": ["{{base_url}}"], "path": ["cms", "media-broadcasts", ""] }
          }
        },
        {
          "name": "Get Impact Metrics",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant", "value": "{{tenant_header}}" }],
            "url": { "raw": "{{base_url}}/cms/impact-metrics/", "host": ["{{base_url}}"], "path": ["cms", "impact-metrics", ""] }
          }
        },
        {
          "name": "Get Articles & Insights",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant", "value": "{{tenant_header}}" }],
            "url": { "raw": "{{base_url}}/cms/articles/", "host": ["{{base_url}}"], "path": ["cms", "articles", ""] }
          }
        },
        {
          "name": "Submit Contact Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Tenant", "value": "{{tenant_header}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"phone\": \"+1 555-0199\",\n  \"subject\": \"General Inquiry\",\n  \"message\": \"Interested in collaborating with your programs.\"\n}"
            },
            "url": { "raw": "{{base_url}}/cms/contact/", "host": ["{{base_url}}"], "path": ["cms", "contact", ""] }
          }
        }
      ]
    },
    {
